# The plan corpus is generated by `cargo xtask gen-fixtures`: collapse it in
# diffs, and keep LF line endings so tests see identical bytes on every OS.
fixtures/pg/** linguist-generated=true
fixtures/pg/** text eol=lf
fixtures/scenarios/*.sql text eol=lf
fixtures/schema.sql text eol=lf
# Captured psql output and log files: byte-for-byte as captured.
fixtures/inputs/** text eol=lf
fixtures/logs/** text eol=lf
fixtures/requests/** text eol=lf
# Report snapshots compare byte for byte.
crates/explainsql-core/tests/snapshots/*.snap text eol=lf
# Mounted into a Linux container: keep LF on Windows checkouts too.
playground/** text eol=lf
